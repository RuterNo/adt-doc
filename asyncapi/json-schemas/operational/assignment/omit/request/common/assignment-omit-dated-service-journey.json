{
  "$id": "https://schemas.ruter.no/adt/ota/api/v3.0/operational/assignment/omit/request/common/assignment-omit-dated-service-journey.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssignmentOmitDatedServiceJourney",
  "description": "Assignment journey used for Omits",
  "additionalProperties": true,
  "type": "object",
  "required": [
    "datedServiceJourneyId"
  ],
  "properties": {
    "datedServiceJourneyId": {
      "$id": "#/properties/datedServiceJourneyId",
      "description": "DatedServiceJourneyId of the journey",
      "type": "string"
    },
    "serviceWindow": {
      "$id": "#/properties/serviceWindow",
      "description": "Optional. Use serviceWindow to limit what calls are included",
      "$ref": "../../../common/assignment-service-window.json"
    },
    "calls": {
      "$id": "#/properties/calls",
      "description": "Optional. Use calls to add specific calls to the omit message",
      "type": "array",
      "items": {
        "$ref": "./assignment-omit-dated-service-journey-call.json"
      }
    }
  }
}
