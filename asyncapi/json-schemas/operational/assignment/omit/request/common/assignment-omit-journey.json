{
  "$id": "https://schemas.ruter.no/adt/ota/api/v3.0/operational/assignment/omit/request/common/assignment-omit-journey.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssignmentOmitJourney",
  "description": "Journey used in for Omit",
  "additionalProperties": true,
  "type": "object",
  "required": [
    "lineId",
    "vehicleJourneyId"
  ],
  "properties": {
    "vehicleJourneyId": {
      "$id": "#/properties/vehicleJourneyId",
      "description": "Required. Also known as 'turnummer'/trip number of the journey",
      "type": "string"
    },
    "lineId": {
      "$id": "#/properties/lineId",
      "description": "Required. Id for the line, e.g.: 'RUT:Line:32'",
      "type": "string"
    },
    "serviceWindow": {
      "$id": "#/properties/serviceWindow",
      "$ref": "../../../common/assignment-service-window.json"
    },
    "calls": {
      "$id": "#/properties/calls",
      "description": "Calls to omit, un-omit",
      "type": "array",
      "items": {
        "$ref": "assignment-omit-journey-call.json"
      }
    }
  }
}
