{
  "$id": "https://schemas.ruter.no/adt/ota/api/v3.0/operational/assignment/attempt/request/common/assignment-attempt-sign-on.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssignmentAttemptSignOn",
  "description": "Attempt to sign the vehicle on to a specified plan. Please provide either a list of datedServiceJourneys, journeys or the combination of vehicleTaskId and serviceWindow",
  "additionalProperties": true,
  "type": "object",
  "required": [],
  "properties": {
    "code": {
      "$id": "#/properties/code",
      "description": "Specification of the reason why the vehicle should be signed on.",
      "type": "string",
      "examples": [
        "PLANNED",
        "EXTRA",
        "REPLACEMENT"
      ]
    },
    "datedServiceJourneys": {
      "$id": "#/properties/datedServiceJourneys",
      "type": "array",
      "items": {
        "$ref": "assignment-attempt-sign-on-dated-service-journey.json"
      }
    },
    "journeys": {
      "$id": "#/properties/journeys",
      "type": "array",
      "items": {
        "$ref": "assignment-attempt-sign-on-journey.json"
      }
    },
    "vehicleTaskId": {
      "$id": "#/properties/vehicleTaskId",
      "description": "Id of the vehicle task. To pick the plan from",
      "type": "string"
    },
    "serviceWindow": {
      "$id": "#/properties/serviceWindow",
      "description": "First departure and last arrival",
      "$ref": "../../../common/assignment-service-window.json"
    }
  }
}
