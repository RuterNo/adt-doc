{
  "mode": "publish",
  "mqtt": {
    "qos": 1,
    "retain": false,
    "topic": "{authorityId}/{operatorId}/{vehicleId}/adt/v4/sensors/apc/{sensorId}",
    "params": [
      "sensorId"
    ]
  },
  "service-level": "external",
  "producers": [
    "pto"
  ],
  "consumers": [
    "pta"
  ],
  "maintainers": [
    "apc"
  ]
}
